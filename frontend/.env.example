# Base URL for the backend API. In dev, leave this unset and Vite's proxy
# (see vite.config.ts) forwards /api to http://localhost:3000 — no CORS
# issues, nothing to configure. Only set this if you're pointing the
# frontend at a backend that isn't on localhost:3000 (e.g. a deployed API).
# VITE_API_BASE_URL="http://localhost:3000/api"
